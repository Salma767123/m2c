{
  "expo": {
    "name": "m2c",
    "slug": "m2c-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/1024.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.m2c.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#f7f7f5",
        "foregroundImage": "./assets/images/1024.png",
        "backgroundImage": "./assets/images/1024.png",
        "monochromeImage": "./assets/images/1024.png"
      },
      "edgeToEdgeEnabled": true
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#111827"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo3.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 230,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-logo.png",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cee6f82f-40a4-4073-840b-50507415e9c8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "karneyar-2002",
    "updates": {
      "url": "https://u.expo.dev/cee6f82f-40a4-4073-840b-50507415e9c8"
    }
  }
}
