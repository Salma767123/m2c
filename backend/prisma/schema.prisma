// ============================================
// SETTLEMENTS
// ============================================

model Settlement {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  settlementNumber String // e.g. SET-2024-0001
  vendorId         String    @db.ObjectId
  vendorName       String
  orderId          String    @db.ObjectId
  billingNumber    String // e.g. same as order invoice number
  period           String // e.g. "February 2024"

  // ── Vendor payout breakdown ────────────────────────────────────────────────
  // M2C BUYS from the vendor and resells to the customer, so the vendor makes a
  // taxable supply to M2C and must be paid their GST on top of their goods value.
  // This is a DIFFERENT tax from Order.tax (which is charged to the customer on
  // M2C's higher selling price). Same HSN rate, different base.
  //
  // Nullable because settlements created before this breakdown existed stored a
  // base-only figure in `amount`; readers fall back to `baseAmount ?? amount`
  // and `taxAmount ?? 0` rather than requiring a data migration.
  /// Vendor's goods value = basePrice x qty, before their GST.
  baseAmount       Float?
  /// Vendor's GST on baseAmount. 0 for vendors with no GSTIN (unregistered).
  taxAmount        Float?
  /// Rate applied — set only when every line shares one rate; null when mixed.
  gstPercentage    Float?

  /// GROSS payable to the vendor = baseAmount + taxAmount.
  amount           Float
  dueDate          DateTime?
  status           String    @default("Pending") // Pending, Processing, Paid, Failed
  paymentDate      DateTime?
  transactionId    String?

  vendor Vendor @relation(fields: [vendorId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settlements")
}

// ============================================
// INSPECTION MANAGEMENT
// ============================================

model Inspection {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relations
  vendorId  String    @db.ObjectId
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  checkerId String    @db.ObjectId
  checker   QCChecker @relation(fields: [checkerId], references: [id], onDelete: Cascade)

  // Assignment Details
  poNumber          String
  clientName        String
  scheduledDate     String // YYYY-MM-DD
  scheduledTime     String // HH:MM AM/PM
  priority          String // high, medium, low
  estimatedDuration String

  // How the inspection was carried out. PHYSICAL means the checker was on-site and is
  // geofenced against the vendor's factory; VIRTUAL means it was done online, so no
  // location is captured or validated. Chosen at start. Defaults to PHYSICAL so every
  // inspection created before this field reads as an on-site one.
  inspectionType InspectionType @default(PHYSICAL)

  // Status & Timing
  status      InspectionStatus @default(SCHEDULED)
  startedAt   DateTime?
  completedAt DateTime?

  // Draft / pause / resume. When a checker saves a draft and exits mid-inspection,
  // draftData holds the full in-progress form snapshot and pausedAt marks when the
  // pause began. On resume the elapsed pause gap is added to totalPausedMs and
  // pausedAt is cleared. Together with startedAt/submittedAt these drive the report's
  // active/paused/total duration breakdown. All cleared on completion.
  draftData     Json?
  pausedAt      DateTime?
  totalPausedMs Int       @default(0)

  // Inspection Items (JSON array of category/subcategory objects assigned)
  itemsToInspect Json

  // Results
  result InspectionResult?
  score  Float?
  notes  String?

  // Re-inspection tracking
  parentInspectionId String? @db.ObjectId
  cycleNumber        Int     @default(1)

  // Rejection details (populated when checker submits as failed)
  rejectionReason      String?
  rejectionRemarks     String?
  rejectionNotes       String?
  locationDetails      String?
  rejectionAttachments String[] @default([])

  // Location verification (QC checker GPS vs vendor factory)
  checkerLatitude   Float?
  checkerLongitude  Float?
  vendorLatitude    Float? // Snapshot of vendor factory lat at inspection time
  vendorLongitude   Float? // Snapshot of vendor factory lng at inspection time
  locationVerified  Boolean @default(false)
  locationDistanceM Float? // Distance in meters between checker and vendor
  // Which registered address the checker was verified against: 'legal/factory' | 'warehouse'.
  // The geofence checks whichever applies, so the report can name the exact site.
  locationMatchedAddress String?

  // Review tracking
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?   @db.ObjectId

  // Scheduling lifecycle. reminderSentAt guards the 1-hour-before reminder so
  // the cron sweep never double-notifies. expiredAt stamps when a SCHEDULED
  // assignment blew past its booked window (scheduledDate+time+duration)
  // without the checker starting — see utils/inspectionSchedule.js.
  reminderSentAt DateTime?
  expiredAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
  @@index([vendorId, status, result])
  @@index([checkerId, status])
  @@index([completedAt])
  @@index([parentInspectionId])
  @@map("inspections")
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  UNDER_ADMIN_REVIEW
  REJECTED
  REINSPECTION
  COMPLETED
  CANCELLED
  // Booked window (scheduledDate + scheduledTime + estimatedDuration) elapsed
  // before the checker started. Terminal — frees the vendor for reassignment.
  EXPIRED
}

enum InspectionResult {
  PASSED
  FAILED
}

enum InspectionType {
  PHYSICAL // On-site — checker GPS captured and geofenced against the vendor factory.
  VIRTUAL  // Online — no location capture or validation.
}

