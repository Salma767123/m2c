  // Never change once shipped — send-sites reference this.
  key String @unique

  // Grouping shown in the admin UI: "ACCOUNT" | "NOTIFICATIONS" | "SECURITY"
  category String

  name        String // Display title, e.g. "Vendor Account Approved"
  description String // Subtitle preview, e.g. "Your {{brandName}} account has been approved"

  subject  String // May contain {{variables}}

  // Rendered, send-ready HTML (derived). Admins no longer edit this directly —
  // it is regenerated from the structured text fields below + the code-side
  // layout registry whenever the template is saved. The send path still just
  // interpolates {{variables}} into this string.
  bodyHtml String

  // ── Structured, admin-editable text content ──
  // The email is composed as: brand header (emoji + title + subtitle) → body
  // message → auto tables/blocks → button → footer. Only these plain-text parts
  // are editable in the UI; the structural pieces live in code.
  emoji          String? // Header emoji, e.g. "🔑"
  headerTitle    String? // Header title, e.g. "Welcome to QC Portal"
  headerSubtitle String? // Header subtitle line
  bodyText       String? // Main message, plain text; blank line = new paragraph; supports {{variables}}
  buttonLabel    String? // CTA button label (only used if the template has a button)
  footerText     String? // Footer line

  // Display name shown in the "From" header, e.g. "QC Portal". Falls back to a
  // global default when null.
  fromName String?

  // Variable names available to this template, for the editor's insert-chips.
  variables String[] @default([])

  // Admins can toggle a template off to stop it sending.
  enabled Boolean @default(true)

  // Security emails (password reset, email verification) always send and
  // cannot be disabled in the UI.
  isSecurity Boolean @default(false)

  // Ordering within a category in the admin list.
  sortOrder Int @default(0)

  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

