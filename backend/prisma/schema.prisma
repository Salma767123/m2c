// ============================================
// PRICE NEGOTIATION
// ============================================

/// One offer in an admin↔vendor price negotiation.
///
/// Append-only: every offer, counter-offer and response is a row, so the
/// product page can render the full timeline ("who proposed what, why, when")
/// without reconstructing it from status changes.
///
/// Negotiation is PRODUCT-level, not variant-level, on purpose: the vendor is
/// paid `Product.basePrice` per line (orderController), and variant prices are
/// not used for settlement. `proposedPercent` lets one agreement scale every
/// variant proportionally instead of forcing a round per variant.
model PriceNegotiation {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId  String  @db.ObjectId
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// 1-based; increments per offer so the timeline orders deterministically
  /// even when two rows share a timestamp.
  round Int

  proposedBy NegotiationParty
  /// Admin id or vendor id — whoever created this row. Plain String, not
  /// @db.ObjectId: this is an audit stamp, not a relation, and the two sides
  /// come from different collections. Constraining it to ObjectId turns any
  /// non-conforming id into a 500 instead of a harmless unlinked stamp.
  proposedById String?

  /// Offered vendor buying price (INR, product level).
  proposedPrice Float
  /// Offered price as a % of the vendor's ORIGINAL asking price. Stored so
  /// variant prices can be scaled by the same factor on acceptance.
  proposedPercent Float?
  /// The price this offer was responding to — lets the UI show "₹200 → ₹150"
  /// per row without walking backwards through the timeline.
  previousPrice Float?

  /// Structured reason code (e.g. MARKET_PRICE_LOWER, BULK_ORDER) plus free text.
  reasonCode String?
  message    String?

  status NegotiationRoundStatus @default(PENDING)

  /// Set when the other side responds to this row.
  respondedAt   DateTime?
  respondedById String?

  /// Offers auto-expire so a silent vendor cannot park a product forever.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, round])
  @@index([vendorId, status])
  @@index([status, expiresAt])
  @@map("price_negotiations")
}
