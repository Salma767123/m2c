# ── Database ─────────────────────────────────────────────────────────────
# MongoDB connection string (Prisma datasource).
# Tip for Vercel/serverless: cap the pool so parallel cold starts don't
# exhaust Atlas connections, e.g. append ?maxPoolSize=5
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/m2c?retryWrites=true&w=majority"

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Long random string — signs all JWTs and the express-session secret
JWT_SECRET=change-me-to-a-long-random-string

# ── Bootstrap admin (auto-created on first startup) ──────────────────────
# ADMIN_EMAIL also routes Google OAuth logins to the Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ── URLs (OAuth redirects, email links, CORS) ────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ── Cloudinary (all media storage) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP (verification, password reset, vendor lifecycle emails) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# ── Razorpay (also configurable per-DB via PaymentSettings) ──────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Firebase push notifications (optional) ───────────────────────────────
# JSON string of the service account key
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Vercel Cron (protects GET /api/jobs/overdue-settlements) ─────────────
# Set the same value in the Vercel project env; Vercel sends it as a Bearer token
CRON_SECRET=
