# NOTE: EAS archives the git root, and it reads the `.easignore` there — not
# this one. Sibling apps (backend/, frontend/, mobile/) must be excluded from
# the ROOT .easignore; `../mobile/` here was a silent no-op that let 43 MB of
# mobile/ into every build. Keep this file for checker_app-local patterns only.
#
# Verify with:
#   npx eas-cli build:inspect --platform android --stage archive --output <dir>

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Dependencies — EAS installs fresh
node_modules/

# Native folders — EAS runs expo prebuild
android/
ios/

# Dev caches
.expo/
.expo-shared/
dist/
web-build/
.cache/
.next/

# Env files — use EAS environment variables
.env
.env.*
!.env.example

# Logs & binaries
*.log
*.mp4
*.mov
*.zip
*.apk
*.aab
*.ipa

# Work artifacts
COMMIT_MESSAGE.txt
WORK_REPORT.md
CHANGES_COMPLETED.md
MOBILE_UPDATES_TODO.md
